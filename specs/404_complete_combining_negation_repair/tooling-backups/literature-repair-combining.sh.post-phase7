#!/usr/bin/env bash
# literature-repair-combining.sh - Backup-guarded, anchored in-place repair engine
# for the combining-mark (U+0338) corruption in the ~/Projects/Literature corpus.
#
# Usage:
#   literature-repair-combining.sh --dir NAME [--dry-run|--write] [--ledger-json]
#
#   --dir NAME    Required. Scope to a single sources/<NAME>/ directory.
#   --dry-run     Report proposed rewrites only (DEFAULT). No backup, no write.
#   --write       Perform the backup-then-rewrite. Requires this flag explicitly;
#                 --dry-run is the safe default with or without the flag present.
#   --ledger-json Emit the residual-ledger entries (unrepaired occurrences) as a
#                 JSON array to stdout instead of the human-readable summary.
#                 Safe in both --dry-run and --write mode.
#   -h, --help    Show this help.
#
# What this repairs: every occurrence `literature_combining_detect.py` classifies
# as `control_char`, `glyph_six`, or `absent` (the three "corrupted, actionable"
# signatures with a uniquely-anchored markdown location AND a known
# base->precomposed target) is rewritten in place: the corrupted span (base
# character plus its adjacent corruption artifact -- a control character, a
# literal "6", or nothing) is replaced by the single precomposed negated
# codepoint (e.g. "=" + control-char -> "≠"). Occurrences already `precomposed`,
# `bare_pair`, or `latex_macro` need no action. Occurrences the detector could
# not uniquely anchor (`unanchored`), or whose base character has no known
# precomposed target, or whose edit span overlaps another occurrence's edit
# span in the same file, are NEVER written -- they are reported as residual-
# ledger entries instead (reasons: ambiguous_anchor, anchor_not_found,
# unrecognized_gap, unmapped_base, unmapped_base_char, overlapping_edit,
# narrow_failed, overlapping_edit_surplus -- the last added in task 404 Phase 7
# for the numerically-excess claimant(s) left over after a shared-span group's
# partial resolution; see _find_sub_spans()'s docstring and the "Partial
# resolution for shared-span groups" comment below for the mechanism).
#
# Backup contract: before the FIRST write to a file in a given UTC calendar day,
# the pre-edit file is mirrored to
#   $LITERATURE_DIR/.backups/combining-repair-{ISO_DATE}/sources/<dir>/<file>
# preserving directory layout. An existing backup for the same file is NEVER
# overwritten (so a second same-day run's backup step is a no-op, not a
# re-snapshot of an already-modified file). A sha256 manifest
# (`.../combining-repair-{ISO_DATE}/manifest.json`) records every backed-up
# file's original hash. Writing to the corpus for a given file is refused if its
# backup could not be created or verified.
#
# Post-write verification (task 404 Phase 1 non-negotiable): the pre-write
# word-count circuit breaker further down this file only ever refuses a write
# BEFORE it happens, and only checks word count -- it says nothing about what
# actually lands on disk, and nothing about byte count. After every --write,
# this script re-reads the just-written file fresh from disk (never from the
# in-memory `new_content` buffer) and recomputes the word delta AND the byte
# delta relative to THIS INVOCATION'S OWN pre-edit read of the file (captured
# earlier in the same run, before any edit was applied), requiring an EXACT
# match against what the accepted edits account for. Any mismatch triggers an
# immediate automatic rollback: the file is overwritten with THIS INVOCATION'S
# own pre-edit content (never the on-disk day-start backup -- see below), and
# every occurrence that was going to be repaired in that file is instead
# recorded as a `post_write_rollback` residual-ledger entry rather than
# silently counted as written.
#
# Why the rollback target is this invocation's own pre-edit read, NOT the
# on-disk backup: the backup contract above intentionally never overwrites an
# existing same-day backup, so on a file that already received a legitimate
# earlier write TODAY (a prior phase's --write, or an earlier run against a
# different subset of a directory), the on-disk backup reflects the START of
# the day, not the immediate pre-edit state for THIS write. Verified as a
# real, corpus-mutating near-miss during this phase: an earlier version of
# this verification used the on-disk backup as both the delta baseline and
# the rollback target, and on baier_katoen_2008 (already partially repaired
# earlier the same day by a prior phase) this rolled back Baier_Katoen_2008_
# part07.md/part08.md all the way to their PRE-that-earlier-repair state,
# silently discarding legitimate prior-same-day edits -- caught only because
# the deltas happened not to reconcile, not by design. Restoring to this
# invocation's own captured pre-edit content undoes only what THIS invocation
# just did, and can never regress an earlier session's legitimate work. The
# on-disk backup remains the durable, external disaster-recovery copy (still
# sha256-verified and manifest-recorded before every write), but is no longer
# consulted for the post-write correctness check or as a rollback source.
#
# Test-only corruption hook: setting the environment variable
# LITERATURE_REPAIR_TEST_INJECT_CORRUPTION=1 makes this script deliberately
# write one extra corrupting line beyond the intended new_content for every
# file in a --write run, so the post-write verification above is guaranteed to
# detect a mismatch and roll back. This exists ONLY to let Phase 1's safety
# audit prove the rollback path actually fires against a real (scratch-copy)
# LITERATURE_DIR, without needing to hand-craft a broken engine build. It must
# NEVER be set for a real corpus run.
#
# Idempotence: running --write twice over the same directory proposes (and
# performs) zero rewrites on the second run -- every genuinely repaired
# occurrence re-classifies as `precomposed` (accounted, no action) when
# `literature_combining_detect.py` re-scans the now-fixed file.
#
# This script NEVER performs a full re-conversion, and NEVER touches chunk_*.md,
# chunks.json, or index.json -- those are Phase 8/9's job.
#
# Environment:
#   LITERATURE_DIR  Path to the global Literature/ repo (default: ~/Projects/Literature)

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
LITERATURE_DIR="${LITERATURE_DIR:-$HOME/Projects/Literature}"
DIR_FILTER=""
MODE="dry-run"
LEDGER_JSON="0"

usage() {
  cat <<'EOF'
Usage: literature-repair-combining.sh --dir NAME [--dry-run|--write] [--ledger-json]

  --dir NAME     Required. Scope to a single sources/<NAME>/ directory.
  --dry-run      Report proposed rewrites only (DEFAULT). No backup, no write.
  --write        Perform the backup-then-rewrite.
  --ledger-json  Emit residual-ledger entries as JSON to stdout.
  -h, --help     Show this help.
EOF
}

while [ $# -gt 0 ]; do
  case "$1" in
    --dir)
      DIR_FILTER="${2:-}"
      shift 2
      ;;
    --write)
      MODE="write"
      shift
      ;;
    --dry-run)
      MODE="dry-run"
      shift
      ;;
    --ledger-json)
      LEDGER_JSON="1"
      shift
      ;;
    -h | --help)
      usage
      exit 0
      ;;
    *)
      echo "Unknown argument: $1" >&2
      usage
      exit 1
      ;;
  esac
done

if [ -z "$DIR_FILTER" ]; then
  echo "Error: --dir NAME is required" >&2
  usage
  exit 1
fi

if [ ! -d "$LITERATURE_DIR" ]; then
  echo "Error: LITERATURE_DIR not found: $LITERATURE_DIR" >&2
  exit 1
fi

SOURCES_DIR="$LITERATURE_DIR/sources"
if [ ! -d "$SOURCES_DIR" ]; then
  echo "Error: sources/ not found under LITERATURE_DIR: $SOURCES_DIR" >&2
  exit 1
fi

ISO_DATE="$(date -u +%Y-%m-%d)"
BACKUP_ROOT="$LITERATURE_DIR/.backups/combining-repair-$ISO_DATE"

LITERATURE_DIR="$LITERATURE_DIR" \
SOURCES_DIR="$SOURCES_DIR" \
DIR_FILTER="$DIR_FILTER" \
MODE="$MODE" \
LEDGER_JSON="$LEDGER_JSON" \
BACKUP_ROOT="$BACKUP_ROOT" \
LITERATURE_SCRIPT_DIR="$SCRIPT_DIR" \
python3 <<'PYEOF'
import hashlib
import json
import os
import re
import shutil
import sys
import tempfile
import datetime

sys.path.insert(0, os.environ["LITERATURE_SCRIPT_DIR"])
try:
    import fitz  # noqa: F401
except ImportError as e:
    print(f"[repair-combining] PyMuPDF (fitz) not available: {e}", file=sys.stderr)
    sys.exit(2)

from literature_combining_detect import scan_directory, REPLACEMENTS  # noqa: E402

LITERATURE_DIR = os.environ["LITERATURE_DIR"]
SOURCES_DIR = os.environ["SOURCES_DIR"]
DIR_FILTER = os.environ["DIR_FILTER"]
MODE = os.environ["MODE"]
LEDGER_JSON = os.environ.get("LEDGER_JSON", "0") == "1"
BACKUP_ROOT = os.environ["BACKUP_ROOT"]

REPAIRABLE_SIGNATURES = {"control_char", "glyph_six", "absent"}


def no_markdown_notice(dirname):
    print(f"[repair-combining] {dirname}: has PDF but no converted markdown "
          f"(non-chunk *.md) -- nothing to repair.", file=sys.stderr)


def sha256_of(path):
    h = hashlib.sha256()
    with open(path, "rb") as f:
        for chunk in iter(lambda: f.read(65536), b""):
            h.update(chunk)
    return h.hexdigest()


def backup_file(md_path):
    """Mirror md_path into BACKUP_ROOT preserving its sources/<dir>/<file>
    layout, UNLESS a backup for this exact path already exists (never
    overwrite an existing backup). Returns True if a valid backup exists
    (either just created or pre-existing) and it is safe to write, False if
    the backup could not be created/verified (write must be refused)."""
    rel = os.path.relpath(md_path, LITERATURE_DIR)
    backup_path = os.path.join(BACKUP_ROOT, rel)
    if os.path.exists(backup_path):
        return True, backup_path, None
    try:
        os.makedirs(os.path.dirname(backup_path), exist_ok=True)
        shutil.copy2(md_path, backup_path)
        if not os.path.exists(backup_path) or sha256_of(backup_path) != sha256_of(md_path):
            return False, backup_path, "backup verification failed after copy"
        return True, backup_path, None
    except Exception as e:
        return False, backup_path, str(e)


def record_manifest(entries):
    """entries: list of (rel_path, sha256, iso_timestamp). Merge into
    BACKUP_ROOT/manifest.json, never overwriting an existing entry's hash."""
    if not entries:
        return
    manifest_path = os.path.join(BACKUP_ROOT, "manifest.json")
    manifest = {}
    if os.path.exists(manifest_path):
        try:
            with open(manifest_path, "r", encoding="utf-8") as f:
                manifest = json.load(f)
        except Exception:
            manifest = {}
    for rel_path, digest, ts in entries:
        if rel_path not in manifest:
            manifest[rel_path] = {"sha256": digest, "backed_up_at": ts}
    os.makedirs(BACKUP_ROOT, exist_ok=True)
    tmp_fd, tmp_path = tempfile.mkstemp(dir=BACKUP_ROOT, prefix=".manifest.", suffix=".tmp")
    with os.fdopen(tmp_fd, "w", encoding="utf-8") as f:
        json.dump(manifest, f, ensure_ascii=False, indent=2, sort_keys=True)
    os.replace(tmp_path, manifest_path)


def word_count(text):
    return len(text.split())


def atomic_write(path, content):
    d = os.path.dirname(path)
    tmp_fd, tmp_path = tempfile.mkstemp(dir=d, prefix=".repair.", suffix=".tmp")
    try:
        with os.fdopen(tmp_fd, "w", encoding="utf-8") as f:
            f.write(content)
        os.replace(tmp_path, path)
    except Exception:
        if os.path.exists(tmp_path):
            os.remove(tmp_path)
        raise


_CTRL_CLASS = r"\x00-\x08\x0b-\x1f"


def _find_sub_spans(gap_text, group):
    """Given a gap_text span claimed identically by >=2 occurrences (`group`,
    each an edit dict carrying its own occ["base_char"]/occ["signature"]),
    try to locate DISTINCT, non-overlapping literal corruption instances
    within gap_text.

    Returns (spans, exact):
      - spans: the list of found (local_start, local_end) instances in
        left-to-right order, or None if the group isn't the simple
        same-base/same-signature case this refinement handles at all
        (mixed base_char or mixed signature within the group -- see task 404
        Phase 7 Deviations for confirmed real heterogeneous-group cases that
        stay unresolvable by design).
      - exact: True iff len(spans) == len(group). The caller applies the
        found spans unconditionally when exact; when NOT exact but spans is
        non-empty and len(group) > 1, the caller may apply a bounded partial
        resolution (task 404 Phase 7) -- see literature-repair-combining.sh
        header comment "Partial resolution for shared-span groups" for the
        safety argument."""
    base_chars = {e["occ"]["base_char"] for e in group}
    signatures = {e["occ"]["signature"] for e in group}
    if len(base_chars) != 1 or len(signatures) != 1:
        return None, False
    base_char = next(iter(base_chars))
    signature = next(iter(signatures))
    esc = re.escape(base_char)
    # Tolerate up to 2 intervening horizontal-whitespace characters between
    # the corruption artifact and the base -- verified real: bacon_2018's
    # own gap_text is ": A \x0f = B -> L(A \x0f = B).\n" (control char, SPACE,
    # base), the same whitespace-tolerance the converter fix (Phase 2) and
    # the detector's gap classification already accommodate.
    ws = r"[ \t]{0,2}"
    if signature == "control_char":
        pattern = re.compile(f"[{_CTRL_CLASS}]{ws}{esc}|{esc}{ws}[{_CTRL_CLASS}]")
    elif signature == "glyph_six":
        pattern = re.compile(f"6{ws}{esc}|{esc}{ws}6")
    elif signature == "absent":
        pattern = re.compile(esc)
    else:
        return None, False
    spans = [(m.start(), m.end()) for m in pattern.finditer(gap_text)]
    return spans, (len(spans) == len(group))


def main():
    dirpath = os.path.join(SOURCES_DIR, DIR_FILTER)
    if not os.path.isdir(dirpath):
        print(f"Error: directory not found: {dirpath}", file=sys.stderr)
        sys.exit(1)

    result = scan_directory(dirpath, DIR_FILTER, on_no_markdown=no_markdown_notice)
    if result is None:
        # Either no PDF, or no markdown (notice already printed for the latter).
        if LEDGER_JSON:
            print(json.dumps([], ensure_ascii=False, indent=2))
        else:
            print(f"[repair-combining] {DIR_FILTER}: nothing to scan (no PDF, or no markdown).")
        return

    # Group repairable occurrences by md_file.
    by_file = {}
    residual = []

    for occ in result["occurrences"]:
        sig = occ["signature"]
        if sig not in REPAIRABLE_SIGNATURES:
            if sig == "unanchored":
                residual.append({**occ, "dir": DIR_FILTER})
            continue
        base_char = occ["base_char"]
        if base_char not in REPLACEMENTS:
            residual.append({**occ, "dir": DIR_FILTER, "reason": "unmapped_base_char"})
            continue
        md_file = occ["md_file"]
        by_file.setdefault(md_file, []).append({
            "gap_start": occ["md_gap_start"],
            "gap_end": occ["md_gap_end"],
            "replacement": REPLACEMENTS[base_char],
            "occ": occ,
        })

    proposed_rewrites = 0
    files_to_write = {}  # md_file -> new_content
    applied_counts = {}  # md_file -> number of occurrences actually rewritten
    original_by_file = {}  # md_file -> pre-edit content (for post-write verification)
    accepted_by_file = {}  # md_file -> list of accepted edit dicts (for rollback residual entries)

    for md_file, edits in by_file.items():
        with open(md_file, "r", encoding="utf-8", errors="replace") as f:
            original = f.read()

        # Narrow EVERY edit's gap to the precise sub-span containing just the
        # corruption artifact plus its base character (tolerating up to 2
        # intervening whitespace chars), never the raw word-landmark-bracketed
        # gap as-is. CRITICAL: the word-landmark gap classify_occurrence()
        # reports can be, and often is, much WIDER than the actual 1-2
        # character corruption complex -- it only needs to CONTAIN evidence of
        # the signature for classification purposes, not equal it exactly.
        # Verified as a real, corpus-mutating bug during this phase: an
        # initial version of this script used the raw gap span directly as
        # the edit region and deleted real surrounding text (e.g. "with τ
        # <ctrl>∈ H. Only" collapsed to "with∉Only", losing "τ", "H", "."),
        # even for a SINGLE, uniquely-anchored occurrence with no conflicting
        # neighbor. This narrowing step is therefore MANDATORY for every
        # group, not just groups sharing an identical span with >1 occurrence
        # (the shared-span disambiguation case) -- singleton groups need it
        # exactly as much.
        # Partial resolution for shared-span groups (task 404 Phase 7): when a
        # gap window is claimed by >1 occurrence (a shared word-landmark
        # collision -- two different PDF offsets' anchor search converged on
        # the same markdown window) AND every claimant agrees on base_char
        # and signature (so the repair content is identical no matter which
        # claimant a found instance is attributed to), but the window
        # contains FEWER literal corruption instances than claimants, it is
        # safe to repair the instances that ARE found and leave only the
        # numerically-excess claimants as residual -- refusing the entire
        # group (the pre-Phase-7 behavior) is strictly more conservative than
        # necessary here. This does NOT relax anything about what gets
        # WRITTEN (still only a literal, strictly-patterned corruption
        # instance, exactly as narrow single-occurrence groups always
        # required); it only relaxes the bookkeeping requirement that the
        # instance COUNT match the claimant count exactly. Confirmed via 4
        # real corpus cases during Phase 7 triage (arisakadasstrassburger_2015
        # pdf offsets 4912/5058 sharing one glyph_six "|" window with only 1
        # literal instance; baier_katoen_2008 pdf offsets 478192/656136
        # sharing one control_char "|" window; baier_katoen_2008 pdf offsets
        # 770700/771282 sharing one control_char "=" window; baier_katoen_2008
        # pdf offsets 981677/981699 sharing one absent "∈" window) -- see
        # specs/404_complete_combining_negation_repair/progress/phase-7-progress.json.
        # Heterogeneous-base/signature groups (e.g. one claimant base "|",
        # another base "=", sharing one window) remain OUT of scope for this
        # relaxation -- _find_sub_spans returns (None, False) for those and
        # they fall through to the unchanged full-refusal branch below,
        # exactly as before Phase 7 (3 confirmed real baier_katoen_2008 cases
        # in this category during the same triage, each genuinely
        # unresolvable: which claimant's base_char the single ambiguous
        # window's corruption artifact belongs to cannot be determined from
        # the window alone).
        by_span = {}
        for e in edits:
            by_span.setdefault((e["gap_start"], e["gap_end"]), []).append(e)
        narrowed = []
        for (gs, ge), group in by_span.items():
            gap_text = original[gs:ge]
            sub_spans, exact = _find_sub_spans(gap_text, group)
            if sub_spans is not None and exact:
                for e, (local_s, local_e) in zip(group, sub_spans):
                    e["gap_start"] = gs + local_s
                    e["gap_end"] = gs + local_e
                    narrowed.append(e)
            elif sub_spans is not None and len(group) > 1 and 1 <= len(sub_spans) < len(group):
                for e, (local_s, local_e) in zip(group[: len(sub_spans)], sub_spans):
                    e["gap_start"] = gs + local_s
                    e["gap_end"] = gs + local_e
                    narrowed.append(e)
                for e in group[len(sub_spans):]:
                    residual.append({
                        **e["occ"], "dir": DIR_FILTER,
                        "reason": "overlapping_edit_surplus",
                    })
            else:
                # Could not narrow to an exact, unambiguous sub-span -- refuse
                # to guess. A single occurrence whose own gap can't be
                # narrowed is just as unsafe to rewrite as a genuine conflict
                # between multiple occurrences.
                reason = "overlapping_edit" if len(group) > 1 else "narrow_failed"
                for e in group:
                    residual.append({**e["occ"], "dir": DIR_FILTER, "reason": reason})

        narrowed.sort(key=lambda e: e["gap_start"])
        # Defense in depth: detect any remaining overlaps between narrowed
        # spans (should not happen after narrowing, but never trust silently)
        # and verify each edit's net character delta is small -- a real
        # corruption-artifact rewrite removes at most a handful of characters
        # (the base character, one adjacent artifact char, and up to 2
        # whitespace chars); anything larger is refused rather than applied.
        accepted = []
        i = 0
        while i < len(narrowed):
            e = narrowed[i]
            span_len = e["gap_end"] - e["gap_start"]
            if i + 1 < len(narrowed) and narrowed[i + 1]["gap_start"] < e["gap_end"]:
                residual.append({**e["occ"], "dir": DIR_FILTER, "reason": "overlapping_edit"})
                residual.append({**narrowed[i + 1]["occ"], "dir": DIR_FILTER, "reason": "overlapping_edit"})
                i += 2
                continue
            if span_len > 6:
                residual.append({**e["occ"], "dir": DIR_FILTER, "reason": "edit_too_large"})
                i += 1
                continue
            accepted.append(e)
            i += 1

        if not accepted:
            continue

        pieces = []
        cursor = 0
        for e in accepted:
            pieces.append(original[cursor:e["gap_start"]])
            pieces.append(e["replacement"])
            cursor = e["gap_end"]
        pieces.append(original[cursor:])
        new_content = "".join(pieces)

        # Final circuit breaker: a word-count sanity check across the WHOLE
        # file. Each edit replaces a span of at most 6 characters (the
        # per-edit cap above) with a single character, so it can remove at
        # most one "word" boundary artifact -- word count must not drop by
        # more than len(accepted) (generous: a real run never approaches
        # this). If it does, something upstream of this defense is still
        # wrong; refuse the whole file rather than trust the diff.
        word_delta = len(original.split()) - len(new_content.split())
        if word_delta > len(accepted) or word_delta < 0:
            print(f"[repair-combining] REFUSING {md_file}: word-count sanity check failed "
                  f"(original={len(original.split())} words, new={len(new_content.split())} "
                  f"words, delta={word_delta}, edits={len(accepted)}) -- this should never "
                  f"happen; treating as a bug, not writing this file.", file=sys.stderr)
            for e in accepted:
                residual.append({**e["occ"], "dir": DIR_FILTER, "reason": "sanity_check_failed"})
            continue

        if new_content != original:
            files_to_write[md_file] = new_content
            applied_counts[md_file] = len(accepted)
            original_by_file[md_file] = original
            accepted_by_file[md_file] = accepted
            proposed_rewrites += len(accepted)

    # --- Report / act ---
    if LEDGER_JSON:
        print(json.dumps(residual, ensure_ascii=False, indent=2))
        return

    print(f"[repair-combining] {DIR_FILTER}: {proposed_rewrites} proposed rewrite(s) "
          f"across {len(files_to_write)} file(s); {len(residual)} residual (unrepaired) occurrence(s)")
    for md_file in files_to_write:
        print(f"  {os.path.relpath(md_file, LITERATURE_DIR)}: "
              f"{applied_counts[md_file]} occurrence(s) rewritten")

    if MODE == "dry-run":
        print("[repair-combining] --dry-run: no backup created, no files written.")
        return

    # --write: backup-then-rewrite, refusing per-file if backup fails.
    inject_test_corruption = os.environ.get("LITERATURE_REPAIR_TEST_INJECT_CORRUPTION") == "1"
    if inject_test_corruption:
        print("[repair-combining] TEST HOOK ACTIVE: LITERATURE_REPAIR_TEST_INJECT_CORRUPTION=1 "
              "-- every write in this run will be deliberately corrupted to exercise the "
              "post-write rollback path. This must never be set for a real corpus run.",
              file=sys.stderr)

    manifest_entries = []
    written = 0
    refused = 0
    rolled_back = 0
    now_iso = datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
    for md_file, new_content in files_to_write.items():
        ok, backup_path, err = backup_file(md_file)
        if not ok:
            print(f"[repair-combining] REFUSING write to {md_file}: backup failed ({err})",
                  file=sys.stderr)
            refused += 1
            continue
        rel = os.path.relpath(md_file, LITERATURE_DIR)
        manifest_entries.append((rel, sha256_of(backup_path), now_iso))

        original = original_by_file[md_file]
        accounted_word_delta = word_count(original) - word_count(new_content)
        accounted_byte_delta = len(original.encode("utf-8")) - len(new_content.encode("utf-8"))

        write_payload = new_content
        if inject_test_corruption:
            write_payload = new_content + "\nLITERATURE_REPAIR_TEST_INJECT_CORRUPTION\n"
        atomic_write(md_file, write_payload)

        # POST-WRITE VERIFICATION -- re-read the just-written file fresh from
        # disk (never from the in-memory `new_content` buffer) and require an
        # EXACT match on both word delta and byte delta against what the
        # accepted edits account for, computed relative to THIS INVOCATION'S
        # OWN pre-edit read (`original`, captured earlier in this same run,
        # before any edit was applied) -- never relative to the on-disk
        # backup. This distinction is safety-critical, not stylistic: the
        # backup contract (see this script's header) intentionally does NOT
        # overwrite an existing same-day backup, so on a file that already
        # received a legitimate earlier write TODAY (e.g. an earlier phase's
        # --write, or a prior run against a subset of this directory), the
        # on-disk backup reflects the START of the day, not the immediate
        # pre-edit state for THIS write. Verified as a real, corpus-mutating
        # near-miss during this phase: an earlier version of this check used
        # backup-on-disk as both the delta baseline AND the rollback
        # restoration target, and rolling back to a stale day-start backup
        # would silently DISCARD every legitimate edit made earlier the same
        # day (caught here only because the deltas happened not to
        # reconcile -- a coincidental save, not a guarantee). The correct,
        # safe rollback target is always this invocation's own captured
        # `original`: restoring to it undoes only what THIS invocation just
        # did, never anything written by an earlier session. The on-disk
        # backup is retained purely as the durable, external disaster-recovery
        # copy (its sha256 goes in the manifest regardless); a mismatch
        # between it and `original` is expected and logged informationally
        # whenever this is not the first write of the day to this file, and
        # is NEVER itself a rollback trigger.
        with open(md_file, "r", encoding="utf-8", errors="replace") as f:
            written_on_disk = f.read()

        actual_word_delta = word_count(original) - word_count(written_on_disk)
        actual_byte_delta = len(original.encode("utf-8")) - len(written_on_disk.encode("utf-8"))

        if written_on_disk != new_content:
            mismatch = True
        elif actual_word_delta != accounted_word_delta or actual_byte_delta != accounted_byte_delta:
            mismatch = True
        else:
            mismatch = False

        try:
            with open(backup_path, "r", encoding="utf-8", errors="replace") as f:
                backup_on_disk = f.read()
            if backup_on_disk != original:
                print(f"[repair-combining] NOTE: backup for {md_file} predates this "
                      f"invocation's edit (this is not the first write today to this "
                      f"file) -- the day-start backup is informational only and was NOT "
                      f"used as the rollback reference.", file=sys.stderr)
        except Exception:
            pass

        if mismatch:
            print(f"[repair-combining] POST-WRITE VERIFICATION FAILED for {md_file}: "
                  f"word_delta actual={actual_word_delta} accounted={accounted_word_delta}, "
                  f"byte_delta actual={actual_byte_delta} accounted={accounted_byte_delta}, "
                  f"written_matches_intended={written_on_disk == new_content} -- "
                  f"ROLLING BACK {md_file} to this invocation's own pre-edit state "
                  f"(NOT the day-start backup).", file=sys.stderr)
            atomic_write(md_file, original)
            rolled_back += 1
            for e in accepted_by_file[md_file]:
                residual.append({**e["occ"], "dir": DIR_FILTER, "reason": "post_write_rollback"})
            continue

        written += 1

    record_manifest(manifest_entries)
    print(f"[repair-combining] --write: {written} file(s) written, {refused} refused "
          f"(backup failure), {rolled_back} rolled back (post-write verification failure), "
          f"backup root: {BACKUP_ROOT}")


main()
PYEOF
